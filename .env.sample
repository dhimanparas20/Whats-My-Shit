# ============================================================
# WMS environment sample — copy to `.env` and fill in real values.
# `.env` is GITIGNORED: never commit real credentials.
# All keys are case-insensitive against configs/config.py field names.
# ============================================================

# ── Redis (app) ─────────────────────────────────────────────
# Sync redis used by Huey + ephemeral stores (task tracker, future OTP/idempotency)
REDIS_URL=redis://localhost:6379/0

# ── WAHA (app → waha container) ─────────────────────────────
# How THIS app reaches WAHA. In Docker use the service name; locally use localhost.
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=change-me
WAHA_SESSION=default
WAHA_DEFAULT_COUNTRY_CODE=91

# ── WAHA (consumed by the waha container itself) ────────────
# These configure devlikeapro/waha (compose env_file). app code never reads them.
# WAHA_BASE_URL      = public URL for webhooks/file links
# WHATSAPP_DEFAULT_ENGINE = WEBJS | NOWEB | GOWS
WAHA_BASE_URL=http://localhost:3000
WHATSAPP_DEFAULT_ENGINE=WEBJS
WAHA_NAMESPACE=all
WHATSAPP_START_SESSION=default
WHATSAPP_RESTART_ALL_SESSIONS=True
WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_FOLDER=/app/.media
WAHA_LOG_FORMAT=PRETTY
WAHA_LOG_LEVEL=info
WAHA_PRINT_QR=True

# ── FastAPI (Phase 1 — planned) ─────────────────────────────
API_DEBUG=false
API_PORT=8000
API_HOST=0.0.0.0

# ── OTP (app) ───────────────────────────────────────────────
# pepper: HMAC secret used to hash OTP codes — REQUIRED before real traffic.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
OTP_PEPPER=
OTP_TTL=1800
OTP_LENGTH=6
OTP_MAX_VERIFY_ATTEMPTS=5

# ── Task defaults ───────────────────────────────────────────
# TaskSettings currently reads NO env keys (no env_prefix): defaults are
# retry_count=2, delay=60s. If you later add env_prefix="task_", the keys
# become TASK_RETRY_COUNT / TASK_DELAY — update configs first.
# RETRY_COUNT=2
# DELAY=60

# ── Redis key names (constants) ─────────────────────────────
# NOTE: the user-store setting is USERS (not USER) — USER is a standard
# POSIX env var (your shell login name) and would silently override it.
HUEY_TASK_TRACKER=HUEY_TASK_TRACKER
OTP=OTP
USERS=USER
QUOTA=QUOTA

# ── Logging (app) ───────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FORMAT=json
